# ---------------------------------------------------------------------------
# Gaudham environment configuration
# Copy this file to `.env.local` and fill in what you have.
# The site runs fully in local mode when Firebase / Razorpay keys are missing.
# ---------------------------------------------------------------------------

# Session signing secret. Use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Password for the seeded admin account (default: Gaudham@123)
ADMIN_EMAIL="gaudhaam-ab2004"
ADMIN_PASSWORD="firebase-adminsdk-fbsvc@gaudhaam-ab2004.iam.gserviceaccount.com"

# App URL (used for payment callbacks / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------- Firebase ------------------------------------
# Server-side Firestore access (Firebase Admin SDK, service account).
# Project settings -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ----------------------------- Razorpay ------------------------------------
# Dashboard -> Settings -> API Keys. Use test keys (rzp_test_...) while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=
